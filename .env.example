# =============================================================================
# Wavy Pro — environment template
# Copy to ".env" and fill in real values. NEVER commit the real ".env".
#
# IMPORTANT: The PUBLIC website runs with NONE of these set — all content is
# served from public/content.json & public/articles.json. You only need these
# for the /admin panel (login, content saving, image upload via Supabase).
# =============================================================================

# ---- Runtime (server) ----
NODE_ENV=production
PORT=3000

# ---- Supabase (server-side, runtime) — admin & image upload only ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ---- Supabase (build-time, Vite) — baked into the client for admin login ----
# In Coolify these go under "Build Variables" (not runtime env).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
VITE_SUPABASE_PROJECT_ID=your-project-id
